rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    match /users/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid ||
         (me().classId != null && me().classId == resource.data.classId));
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }

    match /classes/{id} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.admin;
    }

    match /tasks/{id} {
      allow read: if request.auth != null && me().classId == resource.data.classId;
      allow create: if request.auth != null && me().role == 'admin'
        && me().classId == request.resource.data.classId;
      allow update: if request.auth != null && me().classId == resource.data.classId;
      allow delete: if request.auth != null && me().role == 'admin'
        && me().classId == resource.data.classId;
    }
  }
}
